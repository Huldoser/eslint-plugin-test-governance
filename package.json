{
  "name": "eslint-plugin-test-governance",
  "version": "0.2.1",
  "description": "ESLint rules that require a ticket comment above skipped, fixme and tagged Playwright tests.",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "playwright",
    "testing"
  ],
  "homepage": "https://github.com/Huldoser/eslint-plugin-test-governance#readme",
  "bugs": {
    "url": "https://github.com/Huldoser/eslint-plugin-test-governance/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/Huldoser"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Huldoser/eslint-plugin-test-governance.git"
  },
  "license": "MIT",
  "author": "Andrey Rychkov",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.map",
    "docs",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:pack": "node scripts/pack-smoke.mjs",
    "docs": "npm run build && eslint-doc-generator",
    "docs:check": "npm run build && eslint-doc-generator --check",
    "prepack": "npm run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@typescript-eslint/parser": "^8.71.0",
    "@typescript-eslint/utils": "^8.71.0",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-doc-generator": "^3.7.1",
    "eslint-plugin-eslint-plugin": "^7.6.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "6.0",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}
